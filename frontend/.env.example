# Copy to .env.local and adjust if your services run elsewhere.

# Spring Boot backend — sessions, venues, the live simulation stream.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# FastAPI AI service — the layout→graph pipeline behind Layout Studio
# (POST /layout/parse). Only needed for AI floor-plan tracing; the rest of the
# app works without it.
VITE_AI_SERVICE_URL=http://localhost:8000
