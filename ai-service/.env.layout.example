# Layout pipeline configuration. Copy into ai-service/.env

# Set false to skip the VLM entirely and run CV-only (fast, no VRAM, lower accuracy).
LAYOUT_VLM_ENABLED=true

LAYOUT_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# 4-bit keeps the 3B near ~2.2GB. On a 4GB card, leave this on.
LAYOUT_VLM_4BIT=true

# Long edge fed to the vision tower. 896 fits comfortably; 1280 will not on 4GB.
LAYOUT_VLM_MAX_EDGE=896
