# Copy to .env and fill in. .env is gitignored — never commit a real token.
#   cp .env.example .env

# --- Hugging Face Inference API (required by POST /analyze) -------------------
# A read token from https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Full endpoint URLs. Either serverless Inference API:
#   https://api-inference.huggingface.co/models/<org>/<model>
# or a dedicated Inference Endpoint:
#   https://<id>.<region>.aws.endpoints.huggingface.cloud
HF_GNN_URL=https://api-inference.huggingface.co/models/your-org/congestion-gnn
HF_LLM_URL=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-0.5B-Instruct

# Cosmetic only — reported back in modelInfo so the demo can name what answered.
HF_GNN_MODEL=your-org/congestion-gnn
HF_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Timeouts and retries ----------------------------------------------------
# Per-attempt timeout in seconds. Serverless endpoints cold-start; the client also honours
# the estimated_time HF returns with a 503, so it waits the amount it was asked to.
HF_TIMEOUT_SECONDS=12
# Retries after the first attempt. 2 means up to 3 calls total.
HF_MAX_RETRIES=2
HF_LLM_MAX_NEW_TOKENS=90

# --- Self-hosted fallback path (optional) ------------------------------------
# Only read by /predict/risk and /generate/advisory, not by /analyze.
# CROWDFLOW_GNN_CHECKPOINT=../ml/out/congestion_gnn.pt
# CROWDFLOW_ADVISORY_MODEL=Qwen/Qwen2.5-0.5B-Instruct
